{
  "name": "timebloker-desktop",
  "version": "1.0.0",
  "description": "TimeBloker Native Windows Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "timebloker",
    "productivity",
    "time-blocking",
    "windows",
    "electron"
  ],
  "author": "SedroulReivax",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "build": {
    "appId": "com.timebloker.app",
    "productName": "TimeBloker",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist-win"
    }
  }
}
